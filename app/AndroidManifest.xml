<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.odin.tvpanel"
    android:versionCode="15"
    android:versionName="1.0.4">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Not granted on install. Granted once over ADB (pm grant) after wireless-debugging pairing,
         only so the app can switch wireless debugging back on after a reboot. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.live_tv" android:required="false" />

    <!-- Package visibility (Android 11+): list launchable apps and home screens, detect Philips packages. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.spocky.projengmenu" />
        <package android:name="me.efesser.flauncher" />
        <package android:name="io.github.jqssun.airplay" />
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="org.droidtv.playtv" />
        <package android:name="org.droidtv.tv.frameworklogger" />
    </queries>

    <application
        android:label="Odin TV Magic"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true" />

        <!-- The launcher entry. Keep this name: launchers remember the exact component of a tile
             (Projectivy does), so renaming or removing it breaks the tile on existing installs. -->
        <activity-alias
            android:name=".Magic"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="Odin TV Magic"
            android:icon="@drawable/icon"
            android:banner="@drawable/banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Party mode screen. Started by the app over ADB (exported for that reason);
             it closes itself immediately when no show is running. -->
        <activity
            android:name=".HackerActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <service
            android:name=".PanelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="LAN remote control panel for this TV" />
        </service>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
